# ==============================================================================
# ABHA Production E-Commerce Environment Configuration
# Master Specification Aligned: Strict Credential Protection & Integration Tracking
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Database Configuration
DATABASE_PATH=./data/abha.sqlite

# Security Secrets (Generate high-entropy key in production)
JWT_SECRET=abha_production_secret_key_replace_with_secure_random_hex_32

# Razorpay Payment Gateway Integration
# Status: "Ready to Connect" - Replace with real merchant keys from Razorpay Dashboard
RAZORPAY_KEY_ID=rzp_test_ABHA2026KeyIdPlaceholder
RAZORPAY_KEY_SECRET=ABHA2026SecretPlaceholderKey
RAZORPAY_WEBHOOK_SECRET=whsec_ABHA2026PlaceholderSecret

# SMS & WhatsApp Gateway Integration (e.g. Fast2SMS / Twilio / Gupshup)
# Status: "Ready to Connect"
SMS_GATEWAY_PROVIDER=READY_TO_CONNECT
SMS_API_KEY=
SMS_SENDER_ID=ABHAIN

# Cloud Storage Integration (Optional future S3 / Cloudinary)
# Status: "Not Configured" - Default is local secure vault on server
STORAGE_PROVIDER=LOCAL_VAULT

# Store Identity
STORE_CODE=STORE-001
STORE_NAME=ABHA
STORE_CITY=Beawar
STORE_PINCODE=305901
